<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE filesystem PUBLIC "-//NetBeans//DTD Filesystem 1.2//EN"
    "http://www.netbeans.org/dtds/filesystem-1_2.dtd">
<filesystem>
    <folder name="OptionsDialog">
        <file name="SOX_AI_TOOL.instance">
            <attr methodvalue="org.netbeans.spi.options.OptionsCategory.createCategory"
                  name="instanceCreate"/>
            <attr name="controller"
                  newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeCodeOptionsPanelController"/>
            <attr bundlevalue="io.github.nbplugins.claudecodegui.Bundle#OptionsCategory_Name_SOX_AI_TOOL"
                  name="categoryName"/>
            <attr name="iconBase"
                  stringvalue="io/github/nbplugins/claudecodegui/icons/sox-ai-tool-icon-32.png"/>
            <attr bundlevalue="io.github.nbplugins.claudecodegui.Bundle#OptionsCategory_Keywords_SOX_AI_TOOL"
                  name="keywords"/>
            <attr name="keywordsCategory" stringvalue="SOX_AI_TOOL"/>
            <attr name="position" intvalue="1500"/>
        </file>
    </folder>

    <!-- Project Properties — SOX_AI_TOOL panel -->
    <folder name="Projects">
        <folder name="org-netbeans-modules-maven">
            <folder name="Customizer">
                <file name="SOX_AI_TOOLPanelProvider.instance">
                    <attr name="instanceCreate"
                          newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeProjectPropertiesPanelProvider"/>
                    <attr name="position" intvalue="900"/>
                </file>
            </folder>
        </folder>
        <folder name="org-netbeans-modules-java-j2seproject">
            <folder name="Customizer">
                <file name="SOX_AI_TOOLPanelProvider.instance">
                    <attr name="instanceCreate"
                          newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeProjectPropertiesPanelProvider"/>
                    <attr name="position" intvalue="900"/>
                </file>
            </folder>
        </folder>
        <folder name="org-netbeans-modules-gradle">
            <folder name="Customizer">
                <file name="SOX_AI_TOOLPanelProvider.instance">
                    <attr name="instanceCreate"
                          newvalue="io.github.nbplugins.claudecodegui.settings.ClaudeProjectPropertiesPanelProvider"/>
                    <attr name="position" intvalue="900"/>
                </file>
            </folder>
        </folder>
    </folder>

</filesystem>
